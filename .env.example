# --- Datenbank ---
POSTGRES_PASSWORD=CHANGE_ME_secure_password

# --- Pflicht-Secrets ---
# Generieren: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_chars

# Generieren: openssl rand -hex 16 (ergibt exakt 32 Hex-Zeichen)
ENCRYPTION_KEY=CHANGE_ME_exactly_32_chars

# Generieren: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_secret

# Generieren: openssl rand -hex 32
MCP_BEARER_TOKEN=CHANGE_ME_mcp_bearer_token

# --- URLs (Cloudflare Tunnel Domains) ---
FRONTEND_URL=https://haimcp.arbeitermili.eu
NEXT_PUBLIC_API_URL=https://haimcpapi.arbeitermili.eu
CORS_ORIGIN=https://haimcp.arbeitermili.eu
SERVER_URL=https://haimcpapi.arbeitermili.eu

# --- Ports (extern) ---
AMCP_PORT_UI=3003
AMCP_PORT_MCP=4004

# --- Registrierung / MCP-Auth ---
ALLOW_OPEN_REGISTRATION=false
MCP_AUTH_MODE=legacy
# MCP_API_KEY=
MCP_ALLOW_ANONYMOUS=false
