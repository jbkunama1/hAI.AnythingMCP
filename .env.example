# ============================================================
# hAI.AnythingMCP — Umgebungsvariablen
# Kopieren: cp .env.example .env && joe .env
# ============================================================

# --- Pflichtfelder ---

# App-Secret (mindestens 32 Zeichen, zufällig generieren)
# Generieren mit: openssl rand -hex 32
AMCP_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

# Admin E-Mail (wird beim ersten Login als Admin-Account verwendet)
AMCP_ADMIN_EMAIL=admin@example.com

# --- Ports ---

# Web UI Port
AMCP_PORT_UI=3000

# MCP Endpunkt Port
AMCP_PORT_MCP=4000

# --- Redis (optional) ---
# Redis aktivieren: im docker-compose.yml den Redis-Block einkommentieren
# REDIS_URL=redis://redis:6379

# --- AI-Features (optional, opt-in) ---
# Ohne Key läuft AnythingMCP vollständig ohne LLM-Anbindung
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
